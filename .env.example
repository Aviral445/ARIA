# ─────────────────────────────────────────────────────────────────
# Aria — Environment Variables Template
# Copy this file to '.env' and fill in your own API keys.
# ─────────────────────────────────────────────────────────────────

# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Master Admin Password for Aria Multi-Device Server (Optional)
ARIA_ADMIN_PASSWORD=your_secure_admin_password_here
