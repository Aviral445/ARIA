# ─────────────────────────────────────────────────────────────────
# Aria — Environment Variables Template
# Copy this file to '.env' and fill in your own API keys.
# ─────────────────────────────────────────────────────────────────

# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM / AI Foundation API Key (Get from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Master Admin Password for Aria Multi-Device Server (Optional)
ARIA_ADMIN_PASSWORD=your_secure_admin_password_here

# ── Cloudflare Edge & Zero-Docker Integration ─────────────────────
# Cloudflare API Token (Get at https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Cloudflare Account ID (Found on your Cloudflare dashboard overview)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# (Optional) Cloudflare Tunnel Name or Domain
CLOUDFLARE_TUNNEL_NAME=aria-tunnel
CLOUDFLARE_DOMAIN=aria.yourdomain.com

